{
  "schemaVersion": 2,
  "name": "multi-service-example (with compose cache)",
  "services": {
    "cache": {
      "command": "docker compose up -d cache",
      "cwd": ".",
      "mode": "oneshot",
      "readiness": { "tcp": "127.0.0.1:5349", "timeoutMs": 60000 },
      "shutdown": { "command": "docker compose stop cache" }
    },
    "api": {
      "command": "node api/server.mjs",
      "cwd": ".",
      "url": "http://127.0.0.1:5341",
      "env": { "PORT": "5341" },
      "requiredEnv": ["DEMO_API_TOKEN"],
      "readiness": { "path": "/health", "status": 200, "timeoutMs": 20000 },
      "dependsOn": ["cache"]
    },
    "worker": {
      "command": "node worker/worker.mjs",
      "cwd": ".",
      "env": { "API_URL": "http://127.0.0.1:5341" },
      "requiredEnv": ["DEMO_API_TOKEN"],
      "readiness": { "log": "worker ready", "timeoutMs": 10000 },
      "dependsOn": ["api"]
    },
    "web": {
      "command": "node web/server.mjs",
      "cwd": ".",
      "url": "http://127.0.0.1:5342",
      "env": { "PORT": "5342", "API_URL": "http://127.0.0.1:5341" },
      "requiredEnv": ["DEMO_API_TOKEN"],
      "readiness": { "path": "/health", "status": 200, "timeoutMs": 20000 },
      "dependsOn": ["api"],
      "shutdown": { "signal": "SIGTERM", "graceMs": 3000 }
    }
  },
  "app": { "service": "web" },
  "startPath": "/",
  "device": "mobile-390"
}
