{
  "name": "agent-device-lab",
  "version": "0.3.1",
  "description": "Lets a coding agent start your web app, use it at phone, tablet or desktop size, and report what breaks, while you watch.",
  "keywords": [
    "agent",
    "coding-agent",
    "mcp",
    "playwright",
    "responsive",
    "mobile",
    "desktop",
    "testing",
    "dev-server",
    "claude-code",
    "codex"
  ],
  "license": "Apache-2.0",
  "author": "Colony Innovations (https://github.com/Colony-Innovations)",
  "homepage": "https://github.com/Colony-Innovations/agent-device-lab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Colony-Innovations/agent-device-lab.git"
  },
  "bugs": {
    "url": "https://github.com/Colony-Innovations/agent-device-lab/issues"
  },
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/Ikafa"
  },
  "type": "module",
  "bin": {
    "agentlab": "bin/agentlab.js"
  },
  "files": [
    "bin/",
    "dist/**/*.js",
    "assets/dashboard/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "flow:clean": "npm run build && node bin/agentlab.js run flows/clean.flow.json",
    "flow:defect": "npm run build && node bin/agentlab.js run flows/mobile-defect.flow.json",
    "prepack": "npm run build",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.82",
    "@types/node": "22.20.4",
    "typescript": "7.0.2"
  }
}
